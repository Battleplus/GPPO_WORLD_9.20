+        ({"prefix-0": True}, {"control-0": [{"step": 1}]}, {"reserved": 20, "verified": 20, "unknown": 1, "pending": 0}, None),
+        ({"prefix-0": True}, {"control-0": [{"step": 1}]}, {"reserved": 20, "verified": 19, "unknown": 0, "pending": 1}, None),
+        ({"prefix-0": True}, {"control-0": [{"step": 1}]}, {"reserved": 20, "verified": 20, "unknown": 0, "pending": 0}, "duplicate"),
+    ],
+    ids=("snapshot_mismatch", "missing_control", "unknown_budget", "pending_budget", "duplicate_branch"),
+)
+def test_first_pair_rejects_incomplete_or_ambiguous_preflight(
+    base_digests, control_labels, budget_totals, results
+):
