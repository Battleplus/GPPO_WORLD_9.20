+        else:
+            proof = "saved original argmax survived the old guard; legal NOOP is no higher than that original action"
+    else:
+        classification = "B"
+        proof = "NOOP was legal and old guard changed an allocation; full candidate probabilities omit NOOP, so equality is unproven"
