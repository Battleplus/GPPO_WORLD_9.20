+def test_no_exclusion_keeps_original_allocation_argmax_and_legal_noop():
+    observation = make_obs(mask=[True, False, True])
+    before = copy.deepcopy(observation)
+    decision = guard.select_guarded_action(observation, [0.8, 0.0, 0.2], task_capacity=2)
+    assert decision.original_action == decision.final_action == 0
+    assert decision.candidate_actions == (0, 2)
+    assert decision.excluded_actions == ()
+    assert observation == before
+
