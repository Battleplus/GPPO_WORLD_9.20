+"""Audit the NOOP contract and saved guard-on rows without execution.
+
+This script reads preserved JSON/JSONL artifacts and source identities only. It
+does not import the experiment runner, open SQLite, call an environment, or
+run a model. The output is deliberately an evidence audit rather than a
+replay: historical rows contain selected probabilities, not the full action
+distribution.
+"""
+
+from __future__ import annotations
+
+import difflib
+import hashlib
+import json
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+from typing import Any, Iterable
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE = ROOT / "runs" / "finite-communication-ack-lease-fix-20260920"
+HISTORICAL = BASE / "ack-known-task-guard-baseline-v1"
+RESUME = BASE / "ack-known-task-guard-resume-20260922"
+OUT = BASE / "ackguard-noop-contract-audit-20260922"
+REVIEW = ROOT.parents[1] / "research-reviews" / "ackguard-resume-review-20260922"
+GUARD = ROOT / "gppo_world" / "ack_known_task_guard.py"
+OLD_GUARD = HISTORICAL / "failure-archive-20260922" / "ack_known_task_guard-original.py"
+SQLITE = HISTORICAL / "budget.sqlite3"
+
+EXPECTED_OLD_GUARD_SHA256 = "6e73323f60647ea48fe05bd841aaa3e0631bd870eb786ad082a07ce007bb207b"
+EXPECTED_SQLITE_SHA256 = "700b0c9173c8debd5cacb8066328dd2359bb913a128f3018710c8129de5e6223"
+
+
+def read_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def read_jsonl(path: Path) -> list[dict[str, Any]]:
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def jsonable(value: Any) -> Any:
+    if isinstance(value, tuple):
+        return [jsonable(item) for item in value]
+    if isinstance(value, list):
+        return [jsonable(item) for item in value]
+    if isinstance(value, dict):
+        return {str(key): jsonable(item) for key, item in value.items()}
+    return value
+
+
+def old_candidate_set(row: dict[str, Any]) -> tuple[list[int], list[int], list[int]]:
+    mask = [bool(value) for value in row["legal_mask"]]
+    noop = len(mask) - 1
+    legal = [index for index, allowed in enumerate(mask) if allowed]
+    excluded = [int(value) for value in row["excluded_actions"]]
+    allocations = [index for index in legal if index != noop]
+    allocation_candidates = [index for index in allocations if index not in set(excluded)]
+    candidates = allocation_candidates if allocation_candidates else ([noop] if noop in legal else [])
+    return legal, excluded, candidates
+
+
+def audit_decision(row: dict[str, Any]) -> dict[str, Any]:
+    legal, excluded, expected_candidates = old_candidate_set(row)
+    mask = [bool(value) for value in row["legal_mask"]]
+    noop = len(mask) - 1
+    action_task_ids = {int(action): str(task) for action, task in row.get("action_task_ids", [])}
+    continuation_actions = [int(value) for value in row.get("continuation_actions", [])]
+    continuation_tasks = {
+        action_task_ids[action]
+        for action in continuation_actions
+        if action != noop and action in action_task_ids
+    }
+    expected_excluded = sorted(
+        action
+        for action in legal
+        if action != noop and action in action_task_ids and action_task_ids[action] in continuation_tasks
+    )
+    errors: list[str] = []
+    saved_candidates = [int(value) for value in row["candidate_actions"]]
+    saved_excluded = [int(value) for value in row["excluded_actions"]]
+    original_action = int(row["original_action"])
+    final_action = int(row["final_action"])
+    if not legal:
+        errors.append("no_legal_action")
+    if original_action not in legal:
+        errors.append("original_action_not_legal")
+    if final_action not in legal:
+        errors.append("final_action_not_legal")
+    if saved_excluded != expected_excluded:
+        errors.append("excluded_actions_identity_mismatch")
+    if saved_candidates != expected_candidates:
+        errors.append("candidate_actions_old_guard_mismatch")
+    if final_action not in saved_candidates:
+        errors.append("final_action_not_in_saved_candidates")
+    if len(saved_candidates) != len(set(saved_candidates)):
+        errors.append("duplicate_candidate_action")
+    if len(saved_excluded) != len(set(saved_excluded)):
+        errors.append("duplicate_excluded_action")
+    reason = str(row.get("reason", ""))
+    expected_allocation_candidates = [action for action in expected_candidates if action != noop]
+    expected_reason = (
+        "excluded_continuation_task"
+        if expected_allocation_candidates and expected_excluded
+        else "no_guard_match"
+        if expected_allocation_candidates
+        else "no_remaining_allocation_choose_noop"
+        if noop in legal
+        else "no_legal_action"
+    )
+    if reason != expected_reason:
+        errors.append("reason_mismatch")
+
+    # A saved original argmax is enough to prove unchanged when it survived.
+    # When the old guard changed to an allocation and NOOP was legal, its
+    # probability is absent, so the new ordering cannot be reconstructed.
+    if errors:
+        classification = "C"
+        proof = "saved row is internally inconsistent: " + ", ".join(errors)
+    elif original_action == noop and final_action != noop:
