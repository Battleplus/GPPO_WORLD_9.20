+    )
+    assert decision.original_action == 2
+    assert decision.final_action == 2
+    assert decision.excluded_actions == (0,)
+    assert decision.candidate_actions == (1, 2)
+    assert decision.reason == "excluded_continuation_task"
+
+    allocation_wins = guard.select_guarded_action(
+        make_obs(mask=[True, True, True], tasks=("task-0", "task-1"), continuation=(0,)),
+        [0.1, 0.9, 0.2],
+        task_capacity=2,
+    )
+    assert allocation_wins.original_action == allocation_wins.final_action == 1
+    assert allocation_wins.candidate_actions == (1, 2)
+
+
+def test_excluded_original_argmax_can_fall_to_noop_and_ties_keep_small_index():
+    observation = make_obs(
+        mask=[True, True, True], tasks=("task-0", "task-1"), continuation=(0,)
+    )
+    decision = guard.select_guarded_action(observation, [0.95, 0.2, 0.8], task_capacity=2)
