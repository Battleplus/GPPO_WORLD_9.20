+    )
+    assert decision.original_action == decision.final_action == 2
+    assert decision.reason == "no_guard_match"
+    assert decision.candidate_actions == (0, 2)
+
+
+def test_exclusion_keeps_noop_in_probability_order():
+    decision = guard.select_guarded_action(
+        make_obs(mask=[True, True, True], tasks=("task-0", "task-1"), continuation=(0,)),
+        [0.1, 0.2, 0.9],
