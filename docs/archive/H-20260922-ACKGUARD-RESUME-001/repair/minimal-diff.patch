+        _last_completed=0,
+        _last_expired=0,
+        _last_energy=1.0,
+        _active_actions={},
+        _communication_log=[],
+    )
+    obs = {
+        "flat": np.zeros(2, dtype=np.float32),
+        "mask": np.asarray([True, True], dtype=np.bool_),
+        "version": 1,
+        "time": 2.0,
+        "public_entity_ids": {"uavs": ("uav-0",), "tasks": ("task-0",)},
+        "continuation_actions": (),
+        "trigger_flags": {},
+    }
+    snapshot = {"env": env, "obs": obs, "policy_hidden": np.asarray([1.0], dtype=np.float32), "cache": {"step": 2}}
+    baseline = RUNNER.snapshot_semantic_digest(snapshot)
+    snapshot["policy_hidden"][0] = 2.0
+    hidden_changed = RUNNER.snapshot_semantic_digest(snapshot)
+    snapshot["policy_hidden"][0] = 1.0
+    snapshot["cache"]["step"] = 3
+    cache_changed = RUNNER.snapshot_semantic_digest(snapshot)
+    assert baseline != hidden_changed
+    assert baseline != cache_changed
