+def _branch(branch_id: str, repeat: int, *, first_feedback: str = "accepted") -> dict:
+    decision = {
+        "step": 1,
+        "final_action": 0,
+        "original_action": 1,
+        "legal_mask": [1, 1],
+        "runtime_action_hidden_sha256": "hidden",
+    }
+    return {
+        "branch_id": branch_id,
+        "control_branch_key": f"control-{repeat}",
+        "parent_id": "parent-00",
+        "repeat": repeat,
+        "initial_public_observation_sha256": "public",
+        "env_steps": 10,
+        "rows": 10,
+        "first_step": decision,
+        "first_feedback": first_feedback,
+    }
+
+
+def test_first_pair_is_one_guard_plus_historical_control_and_cumulative_budget():
+    results = [_branch("guard-0", 0), _branch("guard-1", 1)]
+    payload = RUNNER.first_pair_check(
+        results,
+        {"prefix-0": True},
+        control_labels={"control-0": [{"step": index} for index in range(13)]},
+        budget_totals={"reserved": 20, "verified": 20, "unknown": 0, "pending": 0},
+        write_output=False,
+    )
+    assert payload["passed"]
+    assert payload["pair"]["guard_branch_id"] == "guard-0"
+    assert payload["pair"]["historical_control_steps"] == 13
+    assert payload["dynamic_guard_steps_completed"] == 20
+    assert payload["pair"]["guard_first_feedback"] == "accepted"
+
+
+def test_first_pair_unknown_snapshot_evidence_is_not_a_pass():
+    results = [_branch("guard-0", 0), _branch("guard-1", 1)]
+    payload = RUNNER.first_pair_check(
+        results,
+        None,
+        control_labels={"control-0": [{"step": index} for index in range(13)]},
+        budget_totals={"reserved": 20, "verified": 20, "unknown": 0, "pending": 0},
+        write_output=False,
+    )
+    assert payload["checks"]["base_snapshot_unchanged"] is None
+    assert payload["checks_known_passed"] is True
+    assert payload["gate_status"] == "insufficient_evidence"
+    assert payload["passed"] is False
+    assert payload["historical_base_snapshot_check_status"] == "not_recorded"
