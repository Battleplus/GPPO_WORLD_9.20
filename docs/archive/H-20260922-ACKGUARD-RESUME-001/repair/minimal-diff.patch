+def semantic_state(value: Any, active: set[int] | None = None) -> Any:
+    """Canonicalize saved hidden/cache state without serializing unstable objects."""
+    active = set() if active is None else active
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, bytes):
+        return {"type": "bytes", "sha256": hashlib.sha256(value).hexdigest(), "bytes": len(value)}
+    if isinstance(value, np.ndarray):
+        contiguous = np.ascontiguousarray(value)
+        return {
+            "type": "ndarray",
+            "dtype": str(contiguous.dtype),
+            "shape": list(contiguous.shape),
+            "sha256": hashlib.sha256(contiguous.tobytes()).hexdigest(),
+        }
+    if hasattr(value, "detach") and hasattr(value, "shape"):
+        tensor = value.detach().cpu().contiguous()
+        return {
+            "type": "tensor",
+            "dtype": str(tensor.dtype),
+            "shape": list(tensor.shape),
+            "sha256": hashlib.sha256(tensor.numpy().tobytes()).hexdigest(),
+        }
+    identity = id(value)
+    if identity in active:
+        return {"type": f"{type(value).__module__}.{type(value).__qualname__}", "cycle": True}
+    active.add(identity)
+    try:
+        if isinstance(value, Mapping):
+            return {
+                "type": "mapping",
+                "items": [[str(key), semantic_state(item, active)] for key, item in sorted(value.items(), key=lambda pair: str(pair[0]))],
+            }
+        if isinstance(value, (list, tuple)):
+            return {"type": type(value).__name__, "items": [semantic_state(item, active) for item in value]}
+        if isinstance(value, set):
+            items = [semantic_state(item, active) for item in value]
+            return {"type": "set", "items": sorted(items, key=lambda item: json.dumps(item, sort_keys=True, default=json_default))}
+        state = getattr(value, "__dict__", None)
+        if isinstance(state, Mapping):
+            return {
+                "type": f"{type(value).__module__}.{type(value).__qualname__}",
+                "state": semantic_state(state, active),
+            }
+        return {"type": f"{type(value).__module__}.{type(value).__qualname__}"}
+    finally:
+        active.remove(identity)
