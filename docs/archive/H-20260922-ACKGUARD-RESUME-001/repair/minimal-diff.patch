+def test_ordinary_run_refuses_existing_records_before_model_or_budget_construction(monkeypatch):
+    temp_root = Path(tempfile.mkdtemp(prefix="ackguard-test-", dir=str(RUNNER.WORKTREE)))
+    try:
+        out_dir = temp_root / "run"
+        out_dir.mkdir()
+        (out_dir / "prepare-status.json").write_text('{"status": "prepared"}\n', encoding="utf-8")
+        (out_dir / "branch-results.jsonl").write_text('{"branch_id": "already-there"}\n', encoding="utf-8")
+        events = []
+
+        class Helper:
+            def load_modules(self, *_args, **_kwargs):
+                events.append("load_modules")
+                raise AssertionError("module loading must be gated")
+
+            def load_models(self, *_args, **_kwargs):
+                events.append("load_models")
+                raise AssertionError("model loading must be gated")
+
+        monkeypatch.setattr(RUNNER, "OUT", out_dir)
+        monkeypatch.setattr(RUNNER, "load_helper", lambda: (events.append("load_helper") or Helper()))
+        with pytest.raises(RuntimeError, match="ordinary run refuses existing branch records"):
+            RUNNER.run_matrix()
+        assert events == []
+    finally:
+        shutil.rmtree(temp_root, ignore_errors=True)
+
