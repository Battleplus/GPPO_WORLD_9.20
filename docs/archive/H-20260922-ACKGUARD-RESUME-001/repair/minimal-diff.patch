+def read_budget_state_readonly(path: Path, run_id: str = RUN_ID) -> dict[str, Any]:
+    """Read the persistent ledger without opening it through a mutating writer."""
+    uri = "file:" + path.as_posix() + "?mode=ro"
+    with sqlite3.connect(uri, uri=True) as con:
+        con.row_factory = sqlite3.Row
+        integrity = con.execute("PRAGMA integrity_check").fetchone()[0]
+        metadata = {str(row[0]): str(row[1]) for row in con.execute("SELECT key,value FROM metadata ORDER BY key")}
+        stages = [dict(row) for row in con.execute("SELECT stage,limit_amount,reserved,verified,unknown FROM stages ORDER BY stage")]
+        attempts = [dict(row) for row in con.execute("SELECT attempt_id,stage,reserved,verified,unknown,run_id FROM attempts ORDER BY attempt_id,stage")]
+        reservations = [dict(row) for row in con.execute("SELECT status,COUNT(*) AS count,SUM(amount) AS amount FROM reservations GROUP BY status ORDER BY status")]
+        run_totals = [dict(row) for row in con.execute(
+            "SELECT stage,COALESCE(SUM(amount),0) AS reserved,COALESCE(SUM(CASE WHEN status='verified' THEN amount ELSE 0 END),0) AS verified,COALESCE(SUM(CASE WHEN status='unknown' THEN amount ELSE 0 END),0) AS unknown FROM reservations WHERE run_id=? GROUP BY stage ORDER BY stage",
+            (run_id,),
+        )]
+        run_attempts = [dict(row) for row in con.execute(
+            "SELECT attempt_id,stage,reserved,verified,unknown,run_id FROM attempts WHERE run_id=? ORDER BY attempt_id,stage",
+            (run_id,),
+        )]
+        history_count = int(con.execute("SELECT COUNT(*) FROM history").fetchone()[0])
+    for row in run_totals:
+        row["pending"] = int(row["reserved"]) - int(row["verified"]) - int(row["unknown"])
+    return {
+        "path": str(path),
+        "integrity_check": integrity,
+        "metadata": metadata,
+        "stages": stages,
+        "attempts": attempts,
+        "reservations_by_status": reservations,
+        "run_totals": run_totals,
+        "run_attempts": run_attempts,
+        "history_count": history_count,
