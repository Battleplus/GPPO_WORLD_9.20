+from __future__ import annotations
+
+import copy
+
+import numpy as np
+
+from tools.r_control_digest_schema_20260922 import digest_pair, evaluate_bridge
+
+
+def _obs() -> dict:
+    return {
+        "flat": np.asarray([0.0, 1.25, -2.0], dtype=np.float32),
+        "mask": np.asarray([True, False, True], dtype=np.bool_),
+        "version": 82,
+        "time": 2.0,
+        "public_entity_ids": {"uavs": ("uav-0",), "tasks": ("task-0",)},
+        "continuation_actions": (13,),
+        "trigger_flags": {"task_arrival": False},
+    }
+
+
+def _identity() -> dict:
+    return {
+        "prefix_id": "parent-x|W1|seed-1101|prefix-0",
+        "parent_id": "parent-x",
+        "condition": "W1",
+        "model_seed": 1101,
+        "repeat": 0,
+        "mode": "R",
+        "step": 1,
+        "exogenous_key": "history|parent-x|W1|repeat-0",
+    }
+
+
+def _bridge_kwargs(obs: dict) -> dict:
+    pair = digest_pair(obs)
+    identity = _identity()
+    return {
+        "label_identity": identity,
+        "expected_identity": copy.deepcopy(identity),
+        "label_digest": pair["pilot"]["sha256"],
+        "prefix_digest": pair["historical"]["sha256"],
+        "prefix_time": 2.0,
+        "label_time_before": 2.0,
+        "label_time_after": 3.0,
+    }
+
+
+def test_same_observation_matches_both_known_schemas():
+    obs = _obs()
+    pair = digest_pair(obs)
+    assert pair["pilot"]["schema"].startswith("pilot-observer/")
+    assert pair["historical"]["schema"].startswith("replan-value-public/")
+    assert pair["pilot"]["sha256"] != pair["historical"]["sha256"]
+    result = evaluate_bridge(obs, **_bridge_kwargs(obs))
+    assert result["status"] == "schema_compatible"
+    assert result["schema_compatible"] is True
+    assert result["recomputed"]["pilot_sha256"] == pair["pilot"]["sha256"]
+    assert result["recomputed"]["historical_sha256"] == pair["historical"]["sha256"]
+
+
+def test_real_public_field_change_rejects_bridge():
+    obs = _obs()
+    kwargs = _bridge_kwargs(obs)
+    changed = copy.deepcopy(obs)
+    changed["continuation_actions"] = (14,)
+    result = evaluate_bridge(changed, **kwargs)
+    assert result["status"] == "insufficient_evidence"
+    assert "prefix_digest_not_historical_schema" in result["reasons"]
+
+
+def test_time_change_rejects_bridge():
+    obs = _obs()
+    kwargs = _bridge_kwargs(obs)
+    changed = copy.deepcopy(obs)
+    changed["time"] = 2.5
+    result = evaluate_bridge(changed, **kwargs)
+    assert result["status"] == "insufficient_evidence"
+    assert "time:prefix_time" in result["reasons"]
+    assert "time:label_time_before" in result["reasons"]
+
+
+def test_identity_change_rejects_bridge():
+    obs = _obs()
+    kwargs = _bridge_kwargs(obs)
+    kwargs["label_identity"]["repeat"] = 1
+    result = evaluate_bridge(obs, **kwargs)
+    assert result["status"] == "insufficient_evidence"
+    assert "identity:repeat" in result["reasons"]
+
+
+def test_missing_observation_or_identity_is_insufficient():
+    obs = _obs()
+    kwargs = _bridge_kwargs(obs)
+    assert evaluate_bridge(None, **kwargs)["status"] == "insufficient_evidence"
+    missing = copy.deepcopy(kwargs["expected_identity"])
+    missing.pop("step")
+    result = evaluate_bridge(obs, label_identity=kwargs["label_identity"], expected_identity=missing,
+                             label_digest=kwargs["label_digest"], prefix_digest=kwargs["prefix_digest"],
+                             prefix_time=2.0, label_time_before=2.0, label_time_after=3.0)
+    assert result["status"] == "insufficient_evidence"
+    assert "missing_identity:step" in result["reasons"]
