+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def read_jsonl(path: Path) -> list[dict[str, Any]]:
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def branch_identity(branch_id: str) -> tuple[str, int]:
+    parts = branch_id.split("|")
+    if len(parts) < 6:
+        raise ValueError(f"invalid H-005 branch id: {branch_id}")
+    repeat = int(parts[4].removeprefix("repeat-"))
+    return parts[0], repeat
+
+
+def candidate_class(row: Mapping[str, Any]) -> tuple[str, list[int], list[int], bool]:
+    candidates = sorted({int(value) for value in row.get("candidate_actions", ())})
+    non_noop = [value for value in candidates if value != 24]
+    noop_retained = 24 in candidates
+    if not candidates:
+        category = "empty_anomaly"
+    elif not non_noop:
+        category = "noop_only"
+    elif len(non_noop) == 1:
+        category = "one_non_noop"
+    else:
+        category = "two_or_more_non_noop"
+    return category, candidates, non_noop, noop_retained
+
+
+def decision_projection(row: Mapping[str, Any]) -> dict[str, Any]:
+    category, candidates, non_noop, noop_retained = candidate_class(row)
+    legal = [index for index, value in enumerate(row.get("legal_mask", ())) if bool(value)]
+    parent, repeat = branch_identity(str(row["branch_id"]))
+    original = int(row["original_action"])
+    final = int(row["final_action"])
+    return {
+        "branch_id": row["branch_id"],
+        "parent_id": parent,
+        "repeat": repeat,
+        "condition": "W1",
+        "model_seed": 1101,
+        "prefix": "prefix-0",
+        "step": int(row["step"]),
+        "reason": row.get("reason"),
+        "category": category,
+        "candidate_actions_after_guard": candidates,
+        "non_noop_candidates_after_guard": non_noop,
+        "public_legal_actions_before_guard": legal,
+        "excluded_actions": sorted(int(value) for value in row.get("excluded_actions", ())),
+        "noop_retained": noop_retained,
+        "original_action": original,
+        "final_action": final,
+        "original_vs_final_changed": original != final,
+        "guard_triggered": bool(row.get("triggered", False)),
+        "selected_action_probability": float(row.get("final_probability", 0.0)),
+        "original_action_probability": float(row.get("original_probability", 0.0)),
+        "public_observation_sha256": row.get("public_observation_sha256"),
+        "policy_hidden_before_sha256": row.get("policy_hidden_before_sha256"),
+        "world_hidden_before_sha256": row.get("world_hidden_before_sha256"),
+        "selected_action_hidden_sha256": row.get("selected_action_hidden_sha256"),
+        "evidence_limits": {
+            "candidate_features_saved": False,
+            "world_logits_saved": False,
+            "only_selected_world_hidden_digest_saved": True,
+            "unexecuted_acceptance_or_reward_observed": False,
+        },
+    }
