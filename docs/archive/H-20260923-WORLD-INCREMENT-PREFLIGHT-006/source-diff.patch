+def test_invalid_evidence_fails_closed(fault):
+    row, manifest = saved_fixture()
+    rows = [row]
+    if fault == "duplicate":
+        rows.append(copy.deepcopy(row))
+    elif fault == "illegal":
+        row["candidate_actions"].append(2)
+    elif fault == "noop":
