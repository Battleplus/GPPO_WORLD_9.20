+def validate_rows(rows: list[dict[str, Any]], manifest: list[dict[str, Any]]) -> dict[str, int]:
+    """Validate saved public decision contracts without importing a runtime."""
+    expected = {row["branch_id"]: row for row in manifest}
+    if len(expected) != len(manifest):
+        raise ValueError("duplicate manifest branch")
+    seen: set[tuple[str, int]] = set()
+    steps: dict[str, list[int]] = defaultdict(list)
+    for row in rows:
+        branch, step = str(row["branch_id"]), int(row["step"])
+        if branch not in expected or (branch, step) in seen:
+            raise ValueError("unknown branch or duplicate decision")
+        seen.add((branch, step))
+        steps[branch].append(step)
+        if row["branch_exogenous_key"] != expected[branch]["historical_exogenous_key"]:
+            raise ValueError("exogenous key mismatch")
+        mask = row["legal_mask"]
+        if len(mask) != 25 or any(x not in (0, 1, False, True) for x in mask):
+            raise ValueError("mask contract")
+        legal = {i for i, value in enumerate(mask) if value}
+        candidates, excluded = row["candidate_actions"], row["excluded_actions"]
+        if len(candidates) != len(set(candidates)) or len(excluded) != len(set(excluded)):
+            raise ValueError("duplicate candidates/exclusions")
+        mappings = row["action_task_ids"]
+        targets = dict(mappings)
+        if len(targets) != len(mappings) or set(targets) != legal - {24}:
+            raise ValueError("public action mapping incomplete")
+        continuation_tasks = set(row["continuation_task_ids"])
+        slot_targets: dict[int, str] = {}
+        for action, task in targets.items():
+            slot = int(action) % 6
+            if slot in slot_targets and slot_targets[slot] != task:
+                raise ValueError("task slot mismatch")
+            slot_targets[slot] = task
+        mapped_continuation = {slot_targets[int(a) % 6] for a in row["continuation_actions"]
+                               if int(a) != 24 and int(a) % 6 in slot_targets}
+        if not mapped_continuation <= continuation_tasks:
+            raise ValueError("continuation identity mismatch")
+        expected_excluded = {a for a, task in targets.items() if task in continuation_tasks}
+        if set(excluded) != expected_excluded or set(candidates) != legal - expected_excluded:
+            raise ValueError("guard candidate mismatch")
+        if 24 not in legal or 24 not in candidates:
+            raise ValueError("NOOP not retained")
+        probs = row["probabilities"]
+        if len(probs) != 25 or [p["action"] for p in probs] != list(range(25)):
+            raise ValueError("probability identity mismatch")
+        values = [float(p["probability"]) for p in probs]
+        if any(not math.isfinite(p) or p < 0 for p in values) or abs(sum(values)-1) > 1e-5:
+            raise ValueError("probability normalization")
+        for i, p in enumerate(probs):
+            if bool(p["legal"]) != bool(mask[i]) or (i not in legal and values[i] != 0):
+                raise ValueError("probability mask mismatch")
+        original = max(legal, key=lambda a: (values[a], -a))
+        final = max(candidates, key=lambda a: (values[a], -a))
+        if (original, final) != (row["original_action"], row["final_action"]):
+            raise ValueError("selection mismatch")
+        if ([p["action"] for p in probs if p["selected"]] != [final]
+                or [p["action"] for p in probs if p["original_argmax"]] != [original]
+                or row["final_probability"] != values[final]
+                or row["original_probability"] != values[original]
+                or bool(row["triggered"]) != (original != final)):
+            raise ValueError("selection metadata mismatch")
+    if set(steps) != set(expected):
+        raise ValueError("missing branch")
+    for branch, numbers in steps.items():
+        if sorted(numbers) != list(range(1, len(numbers)+1)) or len(numbers) > expected[branch]["max_steps"]:
+            raise ValueError("step continuity/cap mismatch")
+    return {"unique_decisions": len(seen), "branches": len(steps), "contract_mismatches": 0}
+
+
+def aggregate(rows: list[dict[str, Any]]) -> dict[str, Any]:
+    projections = [decision_projection(row) for row in rows]
+    by_parent_repeat: dict[tuple[str, int], list[dict[str, Any]]] = defaultdict(list)
+    by_parent: dict[str, list[dict[str, Any]]] = defaultdict(list)
+    for row in projections:
+        by_parent_repeat[(row["parent_id"], row["repeat"])].append(row)
+        by_parent[row["parent_id"]].append(row)
+
+    def summary(items: list[dict[str, Any]]) -> dict[str, Any]:
+        return {
+            "decision_count": len(items),
+            "category_counts": count_map(item["category"] for item in items),
+            "non_noop_candidate_windows": sum(bool(item["non_noop_candidates_after_guard"]) for item in items),
+            "multi_non_noop_windows": sum(item["category"] == "two_or_more_non_noop" for item in items),
+            "one_non_noop_windows": sum(item["category"] == "one_non_noop" for item in items),
+            "noop_only_windows": sum(item["category"] == "noop_only" for item in items),
+            "empty_anomaly_windows": sum(item["category"] == "empty_anomaly" for item in items),
+            "noop_retained_count": sum(item["noop_retained"] for item in items),
+            "original_final_changed_count": sum(item["original_vs_final_changed"] for item in items),
+            "guard_triggered_count": sum(item["guard_triggered"] for item in items),
+        }
+
+    return {
+        "schema": "world-increment-decision-space/1.0.0",
+        "source": {
+            "ledger": str(LEDGER),
+            "ledger_sha256": sha256(LEDGER),
+            "scope": "H-005 observed development data; not validation or heldout",
+        },
+        "all_decisions": summary(projections),
+        "by_parent_repeat": {
+            f"{parent}|repeat-{repeat}": summary(items)
+            for (parent, repeat), items in sorted(by_parent_repeat.items())
+        },
+        "by_parent": {parent: summary(items) for parent, items in sorted(by_parent.items())},
+        "decisions": projections,
+    }
+
