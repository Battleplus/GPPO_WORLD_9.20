+        with path.open('a',encoding='utf-8') as f:
+            f.write(canonical({'recovery_completed':completed,'total_completed':4034+completed,'planned':9600,'last_key':key})+'\n')
+            f.flush()
+    except OSError:
+        monitor.observer_publish_errors=getattr(monitor,'observer_publish_errors',0)+1
